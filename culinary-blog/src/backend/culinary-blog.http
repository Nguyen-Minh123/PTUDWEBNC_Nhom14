GET {{baseUrl}}/api/v1/recipes?page=0&pageSize=10
Accept: application/json

> {%
client.test("12. Rejects an invalid page number", function () {
    client.assert(response.status === 400, "Expected HTTP 400");
});
%}

### 13. Reject a page size above the supported range
GET {{baseUrl}}/api/v1/recipes?page=1&pageSize=101
Accept: application/json

> {%
client.test("13. Rejects an invalid page size", function () {
    client.assert(response.status === 400, "Expected HTTP 400");
});
%}

### 14. Reject an unsupported recipe status
GET {{baseUrl}}/api/v1/recipes?status=Unknown
Accept: application/json

> {%
client.test("14. Rejects an unsupported status", function () {
    client.assert(response.status === 400, "Expected HTTP 400");
});
%}

### 15. Reject an empty full-text search term
GET {{baseUrl}}/api/v1/recipes/search?q=%20&page=1&pageSize=10
Accept: application/json

> {%
client.test("15. Rejects an empty search term", function () {
    client.assert(response.status === 400, "Expected HTTP 400");
});
